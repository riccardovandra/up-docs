# Copy to deploy.env (gitignored) and fill in. `bun run deploy` reads it.

# Where the app is served. Its host is attached as the Worker's custom domain,
# so it must be a zone in the same Cloudflare account.
PUBLIC_ORIGIN=https://docs.example.com
# Comma-separated. Each address signs in as the one admin user.
OWNER_EMAILS=you@example.com
# Sender of sign-in codes and invites; its domain must be verified in Resend.
EMAIL_FROM=UP Docs <docs@example.com>
# From `wrangler d1 create up-docs`.
D1_DATABASE_ID=
