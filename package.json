{
  "name": "up-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build && wrangler d1 migrations apply DB --local && wrangler dev",
    "build": "vite build",
    "deploy": "vite build && sh scripts/deploy.sh",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json"
  },
  "dependencies": {
    "@babel/parser": "7.29.8",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-code-block": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "dompurify": "3.4.16",
    "marked": "17.0.6",
    "pele": "1.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260604.1",
    "@types/node": "24.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  },
  "trustedDependencies": ["esbuild", "workerd"],
  "cloudflare": {
    "bindings": {
      "ADMIN_PASSWORD": {
        "description": "Password for signing in as the admin user. Use 12 or more characters. Leave it empty to turn password sign-in off."
      },
      "OWNER_EMAILS": {
        "description": "Comma-separated email addresses that sign in as the admin user by email code. Optional."
      },
      "EMAIL_FROM": {
        "description": "Sender of sign-in codes and invites, such as `UP Docs <docs@example.com>`. Its domain must be verified in [Resend](https://resend.com/domains)."
      }
    }
  }
}
