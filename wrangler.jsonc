{
  "name": "up-docs",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-05-15",
  // Deploys leave vars set in the dashboard, such as PUBLIC_ORIGIN, in place.
  "keep_vars": true,
  // Works as is on any account: `wrangler dev` locally, `bun run deploy` or the
  // Deploy to Cloudflare button on workers.dev. A deployment needs no custom
  // domain. To use one, add it to the Worker and set PUBLIC_ORIGIN.

  // The SPA is served from Vite's build output, and falls back to index.html.
  // The Worker runs first on every path so each response carries the
  // FRAME_ANCESTORS policy.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  // No database_id: `wrangler deploy` creates or finds the database by name, and
  // the Deploy to Cloudflare button writes the id of the one it creates here.
  // Refer to it by the binding name, DB, since the button lets the name change.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "up-docs",
      "migrations_dir": "migrations",
    },
  ],
  // Images uploaded into docs are stored in D1, and served through /api/images
  // with the doc's access check. To store them in R2 instead, create the bucket
  // and add the line below. Images already stored are not migrated: after a
  // switch in either direction, images uploaded before it stop loading.
  // "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "up-docs-images" }],
  "durable_objects": {
    "bindings": [{ "name": "DOC_ROOM", "class_name": "DocRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocRoom"] }],
  "vars": {
    // OWNER_EMAILS: comma-separated addresses that sign in as the admin user by
    // email code. EMAIL_FROM is the sender of sign-in codes and invites; its
    // domain must be verified in Resend.
    "OWNER_EMAILS": "",
    "EMAIL_FROM": "UP Docs <docs@example.com>",
    // Origins allowed to embed the app (CSP frame-ancestors): app.t3.codes (and preview),
    // local `npx t3` and Vite dev, tailnet-served T3 Code, and the desktop
    // renderer (t3code://app, t3code-dev://app in dev builds).
    "FRAME_ANCESTORS": "https://app.t3.codes https://preview.t3.codes http://localhost:* http://127.0.0.1:* https://*.ts.net t3code://app t3code-dev://app",
  },
  // Optional var PUBLIC_ORIGIN, the base of every URL the app hands out. Unset,
  // the app uses the origin of each request.
  // Secrets: ADMIN_PASSWORD, RESEND_API_KEY (`wrangler secret put <NAME>`). Without
  // RESEND_API_KEY, sign-in codes are printed to the wrangler dev console.
}
